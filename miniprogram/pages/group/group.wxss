.section-inline { display: flex; align-items: center; margin: 30rpx 28rpx 4rpx; }
.section-title { font-size: 34rpx; font-weight: 600; letter-spacing: 4rpx; }
.section-seal { width: 36rpx; height: 8rpx; margin-left: 14rpx; background: var(--color-cinnabar); border-radius: 4rpx; opacity: 0.8; }

.picker-row {
  display: flex; align-items: center; justify-content: space-between;
  border: 1rpx solid #E0D6C6; border-radius: 10rpx;
  padding: 20rpx 24rpx; margin: 20rpx 0;
  background: #fff; font-size: 28rpx;
}
.picker-placeholder { color: var(--color-gray-tip); }
.picker-arrow { color: var(--color-gray-tip); }

.tier-list { margin-bottom: 20rpx; }
.tier-row {
  display: flex; align-items: center; gap: 16rpx;
  border: 1.5rpx solid #E0D6C6; border-radius: 12rpx;
  padding: 20rpx 24rpx; margin-top: 16rpx;
  background: #fff;
}
.tier-row-on { border-color: var(--color-cinnabar); background: rgba(200,36,35,0.04); box-shadow: 0 2rpx 12rpx rgba(200,36,35,0.08); }
.tier-row-hot { border-color: #B7791F; }
.tier-name { font-size: 30rpx; font-weight: 600; }
.tag-gold {
  display: inline-block; font-size: 20rpx; color: #B7791F;
  border: 1rpx solid #B7791F; border-radius: 6rpx; padding: 0 10rpx; margin-left: 10rpx;
}
.tier-benefit { font-size: 24rpx; color: var(--color-gray-tip); margin-top: 6rpx; }
.tier-right { text-align: right; }

.group-card { margin-top: 20rpx; }
.group-head { margin-bottom: 12rpx; }
.group-title { font-size: 30rpx; font-weight: 600; flex: 1; margin-right: 12rpx; }
.group-price-row { gap: 16rpx; margin-bottom: 14rpx; }
.progress-bar { height: 14rpx; background: #F0EAE0; border-radius: 8rpx; overflow: hidden; }
.progress-fill { height: 100%; background: linear-gradient(90deg, var(--color-cinnabar), #E05A55); border-radius: 8rpx; }
.countdown { color: var(--color-cinnabar); font-size: 24rpx; }

.compliance { margin-top: 30rpx; }
.page-paper { padding-bottom: 40rpx; }

.pay-info { padding: 20rpx 40rpx 8rpx; font-size: 28rpx; }
.pay-amount { margin-bottom: 16rpx; }
.pay-line { padding: 8rpx 0; color: #444; word-break: break-all; }
.pay-tip { padding-top: 12rpx; color: var(--color-gray-tip); font-size: 24rpx; }
