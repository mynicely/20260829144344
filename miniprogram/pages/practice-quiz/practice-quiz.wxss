.topbar {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx 0;
  gap: 16rpx;
}
.progress-text { font-size: 26rpx; color: var(--color-cinnabar); font-weight: 600; flex-shrink: 0; }
.progress-bar {
  flex: 1;
  height: 12rpx;
  background: rgba(74, 99, 116, 0.12);
  border-radius: 6rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #C82423, #E05B4A);
  border-radius: 6rpx;
  transition: width 0.3s;
}
.elapsed { font-size: 26rpx; color: var(--color-stone); flex-shrink: 0; }

.quiz-card { margin-top: 20rpx; }
.q-type {
  display: inline-block;
  font-size: 22rpx;
  color: var(--color-cinnabar);
  background: rgba(200, 36, 35, 0.08);
  border: 1rpx solid rgba(200, 36, 35, 0.25);
  border-radius: 6rpx;
  padding: 4rpx 16rpx;
  margin-bottom: 16rpx;
}
.q-text {
  font-size: 32rpx;
  line-height: 1.7;
  font-weight: 500;
  margin-bottom: 24rpx;
}

.option {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  margin-top: 16rpx;
  border: 1rpx solid #EAE3D8;
  border-radius: 10rpx;
  background: #FDFBF7;
}
.option-on {
  border-color: var(--color-cinnabar);
  background: rgba(200, 36, 35, 0.05);
}
.option-key {
  width: 52rpx;
  height: 52rpx;
  line-height: 50rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-stone);
  border: 1rpx solid #D8D0C4;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.option-on .option-key {
  color: #fff;
  background: var(--color-cinnabar);
  border-color: var(--color-cinnabar);
}
.option-text { flex: 1; font-size: 28rpx; line-height: 1.6; }
.option-check {
  width: 32rpx;
  height: 32rpx;
  border: 1rpx solid #D8D0C4;
  border-radius: 50%;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.option-check-on {
  background: var(--color-cinnabar);
  border-color: var(--color-cinnabar);
}

.sheet { margin-top: 20rpx; }
.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
}
.sheet-grid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.sheet-cell {
  width: 68rpx;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-stone);
  border: 1rpx solid #EAE3D8;
  border-radius: 8rpx;
  background: #FAF7F2;
}
.sheet-cell-done {
  color: #fff;
  background: rgba(200, 36, 35, 0.75);
  border-color: var(--color-cinnabar);
}
.sheet-cell-current {
  border: 2rpx solid var(--color-cinnabar);
  font-weight: 700;
}

.opbar {
  display: flex;
  gap: 20rpx;
  margin: 30rpx 24rpx 0;
}
.op-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 30rpx;
  border-radius: 10rpx;
}
.op-btn.ghost {
  background: transparent;
  color: var(--color-stone);
  border: 1rpx solid #D8D0C4;
}
.op-btn.main {
  background: var(--color-cinnabar);
  color: #fff;
  font-weight: 600;
}
.page-paper { padding-bottom: 40rpx; }
