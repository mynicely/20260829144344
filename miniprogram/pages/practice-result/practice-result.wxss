.result-hero {
  margin: 20rpx 24rpx;
  padding: 50rpx 0;
  text-align: center;
  border-radius: 16rpx;
  background: linear-gradient(150deg, #4A6374 0%, #6B8798 100%);
  color: #F8F5F0;
}
.result-score { font-size: 120rpx; font-weight: 800; color: #FFD54F; line-height: 1.1; }
.result-label { font-size: 32rpx; letter-spacing: 8rpx; opacity: 0.9; }
.result-sub { font-size: 26rpx; opacity: 0.85; margin-top: 10rpx; }

.section-inline { display: flex; align-items: center; margin: 30rpx 28rpx 4rpx; }
.section-title { font-size: 34rpx; font-weight: 600; letter-spacing: 4rpx; }
.section-seal { width: 36rpx; height: 8rpx; margin-left: 14rpx; background: var(--color-cinnabar); border-radius: 4rpx; opacity: 0.8; }

.q-item { margin-top: 20rpx; }
.q-head { justify-content: space-between; margin-bottom: 12rpx; }
.q-no {
  width: 44rpx; height: 44rpx; line-height: 44rpx;
  text-align: center; font-size: 24rpx;
  color: var(--color-cinnabar);
  border: 1rpx solid rgba(200, 36, 35, 0.4); border-radius: 50%;
}
.q-right-badge { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 20rpx; }
.q-right { color: #2E7D5B; background: rgba(46,125,91,0.1); border: 1rpx solid rgba(46,125,91,0.3); }
.q-wrong { color: var(--color-cinnabar); background: rgba(200,36,35,0.08); border: 1rpx solid rgba(200,36,35,0.3); }
.q-text { font-size: 28rpx; margin-bottom: 12rpx; }
.q-answer { font-size: 26rpx; color: var(--color-stone); padding: 4rpx 0; }
.q-answer-right { color: #2E7D5B; }
.q-label { color: var(--color-gray-tip); }
.q-analysis { margin-top: 8rpx; padding: 14rpx; background: #FAF7F2; border-radius: 10rpx; font-size: 26rpx; color: #555; }

.result-ops { display: flex; gap: 20rpx; margin: 40rpx 24rpx 0; }
.result-ops gf-button { flex: 1; }
.page-paper { padding-bottom: 40rpx; }
