.q-item { margin-top: 20rpx; }
.q-type { display: inline-block; font-size: 22rpx; color: var(--color-cinnabar); border: 1rpx solid rgba(200,36,35,0.35); border-radius: 6rpx; padding: 2rpx 12rpx; }
.q-text { font-size: 28rpx; margin: 12rpx 0; }
.option-line { padding: 8rpx 0; font-size: 26rpx; color: #444; }
.option-key {
  display: inline-block; width: 44rpx; height: 44rpx; line-height: 44rpx;
  text-align: center; font-size: 24rpx; margin-right: 14rpx;
  border: 1rpx solid #D8D0C4; border-radius: 50%;
  color: var(--color-stone);
}
.q-answer { font-size: 26rpx; padding: 6rpx 0; }
.q-wrong-line { color: var(--color-cinnabar); }
.q-right-line { color: #2E7D5B; }
.q-label { color: var(--color-gray-tip); }
.q-analysis { margin-top: 8rpx; padding: 14rpx; background: #FAF7F2; border-radius: 10rpx; font-size: 26rpx; color: #555; }
.page-paper { padding-bottom: 40rpx; }
