.form-card { margin-top: 20rpx; }
.form-item {
  display: flex; align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx dashed #F0EAE0;
}
.form-label { width: 140rpx; font-size: 28rpx; }
.form-input { flex: 1; font-size: 28rpx; }
.form-value { flex: 1; display: flex; justify-content: space-between; font-size: 28rpx; }
.picker-arrow { color: var(--color-gray-tip); }

.content-area {
  width: 100%; height: 260rpx;
  margin-top: 24rpx;
  border: 1rpx solid #E0D6C6; border-radius: 12rpx;
  padding: 20rpx; box-sizing: border-box;
  font-size: 28rpx;
}

.img-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.img-cell { position: relative; width: 200rpx; height: 200rpx; }
.img-preview { width: 100%; height: 100%; border-radius: 10rpx; }
.img-del {
  position: absolute; right: -10rpx; top: -10rpx;
  width: 40rpx; height: 40rpx; line-height: 40rpx;
  text-align: center; font-size: 30rpx;
  background: rgba(26, 26, 26, 0.65); color: #fff;
  border-radius: 50%;
}
.img-add {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  border: 1rpx dashed #D8D0C4; border-radius: 10rpx;
  background: #FAF7F2;
}
.img-add-plus { font-size: 56rpx; color: var(--color-stone); line-height: 1.2; }

.publish-area { margin: 40rpx 24rpx 0; }
.page-paper { padding-bottom: 40rpx; }
