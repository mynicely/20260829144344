.record-card { margin-top: 20rpx; }
.record-icon {
  width: 68rpx; height: 68rpx; line-height: 68rpx;
  text-align: center; font-size: 30rpx;
  border-radius: 12rpx;
  background: rgba(200, 36, 35, 0.08); color: var(--color-cinnabar);
  border: 1rpx solid rgba(200, 36, 35, 0.25);
  margin-right: 18rpx;
}
.record-name { font-size: 28rpx; font-weight: 600; }
.record-reward { color: var(--color-cinnabar); font-size: 28rpx; font-weight: 600; }
.record-img { width: 100%; border-radius: 10rpx; margin-top: 14rpx; }
.record-content { margin-top: 14rpx; padding: 16rpx; background: #FAF7F2; border-radius: 10rpx; font-size: 26rpx; color: #444; }
.page-paper { padding-bottom: 40rpx; }
