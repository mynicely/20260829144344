.order-card { margin-top: 20rpx; }
.order-title { font-size: 30rpx; font-weight: 600; flex: 1; margin-right: 16rpx; }
.order-meta { margin-top: 16rpx; display: flex; flex-direction: column; gap: 10rpx; }
.order-ops { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 20rpx; }
.op-btn {
  font-size: 26rpx;
  border-radius: 30rpx; padding: 10rpx 32rpx;
}
.op-btn.main { background: var(--color-cinnabar); color: #fff; }
.op-btn.ghost { border: 1rpx solid #D8D0C4; color: var(--color-stone); }
.page-paper { padding-bottom: 40rpx; }
