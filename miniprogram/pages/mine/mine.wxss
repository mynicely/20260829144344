.user-card {
  margin: 20rpx 24rpx;
  padding: 32rpx;
  border-radius: 16rpx;
  background: linear-gradient(150deg, #4A6374 0%, #6B8798 100%);
  color: #F8F5F0;
}
.user-row { display: flex; align-items: center; }
.avatar {
  width: 100rpx; height: 100rpx; line-height: 100rpx;
  text-align: center; font-size: 44rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 50%; margin-right: 22rpx;
  color: #fff;
}
.user-name { font-size: 36rpx; font-weight: 600; }
.user-sub { display: flex; align-items: center; gap: 12rpx; margin-top: 8rpx; }
.user-id-tag {
  font-size: 20rpx; color: #FFD54F;
  border: 1rpx solid #FFD54F; border-radius: 6rpx; padding: 0 10rpx;
}
.user-id-tag-plain { color: #A7E0C9; border-color: #A7E0C9; }
.user-phone { font-size: 22rpx; opacity: 0.75; }
.user-code {
  text-align: center;
  border: 1rpx dashed rgba(255, 255, 255, 0.5);
  border-radius: 10rpx; padding: 10rpx 20rpx;
}
.user-code-label { font-size: 20rpx; opacity: 0.75; }
.user-code-val { font-size: 30rpx; font-weight: 700; letter-spacing: 2rpx; }

.wallet-row {
  display: flex; align-items: center;
  margin-top: 28rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 12rpx;
  padding: 24rpx 0;
}
.wallet-cell { flex: 1; text-align: center; }
.wallet-divider { width: 1rpx; height: 56rpx; background: rgba(255, 255, 255, 0.25); }
.wallet-num { font-size: 44rpx; font-weight: 800; color: #FFD54F; }
.wallet-label { font-size: 22rpx; opacity: 0.8; margin-top: 6rpx; }
.wallet-arrow { color: rgba(255, 255, 255, 0.6); font-size: 32rpx; margin-right: 12rpx; }

.mode-row {
  display: flex; align-items: center;
  margin-top: 20rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
}
.mode-title { font-size: 28rpx; }
.mode-desc { font-size: 22rpx; opacity: 0.7; margin-top: 4rpx; }

.login-entry { display: flex; align-items: center; }
.avatar-plain { background: rgba(255, 255, 255, 0.15); }
.login-tip { flex: 1; font-size: 26rpx; opacity: 0.85; }
.login-btn {
  font-size: 26rpx; color: #4A6374;
  background: #fff; border-radius: 30rpx;
  padding: 12rpx 32rpx; font-weight: 600;
}

.menu {
  display: flex; flex-wrap: wrap;
  margin: 20rpx 24rpx;
  background: var(--card-bg);
  border: var(--border-thin);
  border-radius: var(--radius-md);
  padding: 16rpx 0;
}
.menu-item { width: 25%; display: flex; flex-direction: column; align-items: center; padding: 18rpx 0; }
.menu-icon {
  width: 76rpx; height: 76rpx; line-height: 76rpx;
  text-align: center; font-size: 34rpx;
  border-radius: 14rpx;
  background: rgba(200, 36, 35, 0.07); color: var(--color-cinnabar);
  border: 1rpx solid rgba(200, 36, 35, 0.22);
  margin-bottom: 10rpx;
}
.menu-icon-disabled { opacity: 0.35; }
.menu-label { font-size: 22rpx; }

.logout {
  margin: 40rpx 24rpx 0;
  text-align: center; color: var(--color-cinnabar);
  font-size: 28rpx;
  padding: 24rpx;
  background: var(--card-bg);
  border: var(--border-thin);
  border-radius: var(--radius-md);
}
.page-paper { padding-bottom: 140rpx; }
