<view class="page-paper">
  <view class="login-head">
    <view class="login-logo font-art">翰墨书院</view>
    <view class="login-slogan">书法学习 · 分享推广 · 全程透明</view>
  </view>

  <!-- Tab -->
  <view class="tabs">
    <view class="tab {{tab === 'password' ? 'tab-on' : ''}}" data-tab="password" bindtap="onTabTap">密码登录</view>
    <view class="tab {{tab === 'sms' ? 'tab-on' : ''}}" data-tab="sms" bindtap="onTabTap">验证码登录</view>
    <view class="tab {{tab === 'register' ? 'tab-on' : ''}}" data-tab="register" bindtap="onTabTap">注册</view>
  </view>

  <!-- 密码登录 -->
  <view class="card form-card" wx:if="{{tab === 'password'}}">
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" data-field="phone" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="form-label">密码</text>
      <input class="form-input" password placeholder="请输入密码" value="{{password}}" data-field="password" bindinput="onInput" />
    </view>
    <gf-button type="primary" text="{{submitting ? '登录中…' : '登录'}}" disabled="{{submitting}}" loading="{{submitting}}" bind:tap="onPasswordLogin" />
    <view class="tip" style="text-align:center;margin-top:20rpx;" bindtap="onTabTap" data-tab="sms">忘记密码？用验证码登录</view>
  </view>

  <!-- 验证码登录 -->
  <view class="card form-card" wx:if="{{tab === 'sms'}}">
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{smsPhone}}" data-field="smsPhone" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="form-label">验证码</text>
      <input class="form-input" type="number" maxlength="6" placeholder="请输入6位验证码" value="{{code}}" data-field="code" bindinput="onInput" />
      <view class="code-btn {{smsCountdown > 0 ? 'code-btn-disabled' : ''}}" bindtap="onSendCode">
        {{smsCountdown > 0 ? smsCountdown + 's' : '获取验证码'}}
      </view>
    </view>
    <view class="form-item" wx:if="{{debugCode}}">
      <text class="form-label">测试码</text>
      <view class="form-value">{{debugCode}}（模拟模式已自动填入）</view>
    </view>
    <gf-button type="primary" text="{{submitting ? '登录中…' : '登录 / 注册'}}" disabled="{{submitting}}" loading="{{submitting}}" bind:tap="onSmsLogin" />
    <view class="tip" style="text-align:center;margin-top:20rpx;">未注册的新用户将自动注册，需填写有效邀请码</view>
  </view>

  <!-- 注册 -->
  <view class="card form-card" wx:if="{{tab === 'register'}}">
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{regPhone}}" data-field="regPhone" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="form-label">昵称</text>
      <input class="form-input" maxlength="20" placeholder="请输入昵称" value="{{regNickname}}" data-field="regNickname" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="form-label">邀请码</text>
      <input class="form-input" maxlength="20" placeholder="请输入邀请码（必填）" value="{{regInvite}}" data-field="regInvite" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="form-label">密码</text>
      <input class="form-input" password placeholder="设置登录密码（至少6位）" value="{{regPassword}}" data-field="regPassword" bindinput="onInput" />
    </view>
    <gf-button type="primary" text="{{submitting ? '注册中…' : '注册并登录'}}" disabled="{{submitting}}" loading="{{submitting}}" bind:tap="onRegister" />
  </view>

  <view class="compliance">注册即代表同意《平台规则公示》</view>
  <view class="safe-bottom"></view>
</view>
