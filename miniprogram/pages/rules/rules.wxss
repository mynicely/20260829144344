.tabs {
  display: flex;
  margin: 24rpx;
  background: #fff;
  border: var(--border-thin);
  border-radius: 10rpx;
  overflow: hidden;
}
.tab {
  flex: 1; text-align: center;
  padding: 20rpx 0; font-size: 28rpx;
  color: var(--color-stone);
}
.tab-on {
  color: var(--color-cinnabar); font-weight: 600;
  border-bottom: 4rpx solid var(--color-cinnabar);
}

.rules-head { text-align: center; margin: 24rpx 0 8rpx; }
.rules-title { font-size: 38rpx; font-weight: 600; letter-spacing: 6rpx; }
.rules-update { font-size: 22rpx; color: var(--color-gray-tip); margin-top: 8rpx; }

.rules-body {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #3a3a3a;
  line-height: 1.9;
  white-space: pre-line;
  word-break: break-all;
}
.page-paper { padding-bottom: 40rpx; }
