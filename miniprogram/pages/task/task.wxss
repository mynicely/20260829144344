.hero {
  margin: 20rpx 24rpx;
  padding: 36rpx 24rpx;
  border-radius: 16rpx;
  background: linear-gradient(150deg, #4A6374 0%, #6B8798 100%);
  color: #F8F5F0;
}
.hero-stats { display: flex; }
.stat { flex: 1; text-align: center; }
.stat-num { font-size: 52rpx; font-weight: 800; color: #FFD54F; }
.stat-label { font-size: 22rpx; opacity: 0.85; margin-top: 6rpx; }
.hero-tip { text-align: center; font-size: 22rpx; opacity: 0.85; margin-top: 20rpx; }

.section-inline { display: flex; align-items: center; margin: 30rpx 28rpx 4rpx; }
.section-title { font-size: 34rpx; font-weight: 600; letter-spacing: 4rpx; }
.section-seal { width: 36rpx; height: 8rpx; margin-left: 14rpx; background: var(--color-cinnabar); border-radius: 4rpx; opacity: 0.8; }
.section-link { margin-left: auto; color: var(--color-stone); font-size: 24rpx; }

.task-card { display: flex; align-items: center; padding: 24rpx; }
.task-icon {
  width: 72rpx; height: 72rpx; line-height: 72rpx;
  text-align: center; font-size: 32rpx;
  border-radius: 14rpx;
  background: rgba(200, 36, 35, 0.08); color: var(--color-cinnabar);
  border: 1rpx solid rgba(200, 36, 35, 0.25);
  margin-right: 20rpx;
}
.task-name { font-size: 30rpx; font-weight: 600; }
.task-btn {
  flex-shrink: 0;
  font-size: 26rpx; color: #fff;
  background: var(--color-cinnabar);
  border-radius: 30rpx; padding: 10rpx 30rpx;
}
.task-btn-done { background: #D8D0C4; color: #777; }

.bonus-row { padding: 14rpx 0; border-bottom: 1rpx dashed #F0EAE0; }
.bonus-row:last-child { border-bottom: none; }

.calendar-week { display: flex; margin-bottom: 12rpx; }
.calendar-weekday { flex: 1; text-align: center; color: var(--color-gray-tip); font-size: 22rpx; }
.calendar-grid { display: flex; flex-wrap: wrap; }
.cal-cell {
  width: 14.2857%; height: 72rpx;
  line-height: 72rpx; text-align: center;
  font-size: 24rpx; color: var(--color-stone);
  box-sizing: border-box;
}
.cal-cell-done {
  color: #fff; font-weight: 600;
  background: var(--color-cinnabar);
  border-radius: 50%;
}
.cal-cell-today { border: 2rpx solid #4A6374; border-radius: 50%; }

.homework-entry { display: flex; align-items: center; padding: 24rpx; }
.expand-arrow { color: var(--color-stone); font-size: 32rpx; }
.page-paper { padding-bottom: 40rpx; }

.submit-box { padding: 20rpx 40rpx 8rpx; }
.upload-box {
  border: 1rpx dashed #D8D0C4; border-radius: 12rpx;
  padding: 24rpx; display: flex; justify-content: center;
}
.upload-img { width: 320rpx; height: 320rpx; border-radius: 10rpx; }
.upload-empty { display: flex; flex-direction: column; align-items: center; padding: 30rpx 60rpx; }
.upload-plus { font-size: 64rpx; color: var(--color-stone); line-height: 1.2; }
.submit-textarea {
  width: 100%; height: 220rpx;
  border: 1rpx solid #E0D6C6; border-radius: 12rpx;
  padding: 20rpx; box-sizing: border-box;
  font-size: 28rpx;
}
