.pure-mode { text-align: center; padding: 60rpx 40rpx; }
.pure-icon {
  width: 120rpx; height: 120rpx; line-height: 120rpx;
  margin: 0 auto 24rpx;
  font-size: 56rpx;
  border-radius: 20rpx;
  background: rgba(200, 36, 35, 0.08); color: var(--color-cinnabar);
  border: 2rpx solid rgba(200, 36, 35, 0.3);
}
.pure-title { font-size: 34rpx; font-weight: 600; }
.pure-desc { font-size: 26rpx; color: var(--color-gray-tip); margin: 16rpx 0 30rpx; }

.hero {
  margin: 20rpx 24rpx;
  padding: 36rpx 24rpx;
  border-radius: 16rpx;
  background: linear-gradient(150deg, #4A6374 0%, #6B8798 100%);
  color: #F8F5F0;
}
.hero-title { font-size: 36rpx; letter-spacing: 4rpx; margin-bottom: 24rpx; }
.hero-stats { display: flex; }
.stat { flex: 1; text-align: center; }
.stat-num { font-size: 48rpx; font-weight: 800; color: #FFD54F; }
.stat-label { font-size: 22rpx; opacity: 0.85; margin-top: 6rpx; }

.code-card { margin-top: 20rpx; }
.code-label { font-size: 28rpx; }
.code-value {
  font-size: 44rpx; font-weight: 800; color: var(--color-cinnabar);
  letter-spacing: 6rpx; flex: 1; text-align: center;
}
.code-copy {
  font-size: 24rpx; color: var(--color-cinnabar);
  border: 1rpx solid var(--color-cinnabar);
  border-radius: 24rpx; padding: 6rpx 24rpx;
}

.section-inline { display: flex; align-items: center; margin: 30rpx 0 4rpx; }
.section-title { font-size: 34rpx; font-weight: 600; letter-spacing: 4rpx; }
.section-seal { width: 36rpx; height: 8rpx; margin-left: 14rpx; background: var(--color-cinnabar); border-radius: 4rpx; opacity: 0.8; }

.poster-canvas { width: 100%; height: 640rpx; margin-top: 16rpx; background: #F8F5F0; border-radius: 12rpx; }
.poster-ops { display: flex; gap: 20rpx; margin-top: 20rpx; }
.poster-ops gf-button { flex: 1; }

.friend-row { margin-top: 20rpx; }
.friend-avatar {
  width: 72rpx; height: 72rpx; line-height: 72rpx;
  text-align: center; font-size: 32rpx;
  background: rgba(74, 99, 116, 0.15); color: var(--color-stone);
  border-radius: 50%; margin-right: 16rpx;
}
.friend-name { font-size: 28rpx; }

.rank-row { display: flex; align-items: center; margin-top: 20rpx; padding: 20rpx 28rpx; }
.rank-no {
  width: 52rpx; height: 52rpx; line-height: 52rpx;
  text-align: center; font-size: 26rpx;
  border-radius: 50%;
  border: 1rpx solid #D8D0C4; color: var(--color-stone);
  margin-right: 20rpx;
}
.rank-top { background: rgba(200, 36, 35, 0.1); border-color: var(--color-cinnabar); color: var(--color-cinnabar); }
.rank-name { flex: 1; font-size: 28rpx; }
.rank-count { font-size: 26rpx; color: var(--color-cinnabar); }
.page-paper { padding-bottom: 40rpx; }
