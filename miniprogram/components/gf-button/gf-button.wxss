.gf-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: var(--radius-md);
  font-size: 30rpx;
  box-sizing: border-box;
}
.gf-btn-primary {
  background: var(--color-cinnabar);
  color: #fff;
  border: none;
}
.gf-btn-outline {
  background: transparent;
  color: var(--color-cinnabar);
  border: 1rpx solid var(--color-cinnabar);
}
.gf-btn-ghost {
  background: transparent;
  color: var(--color-stone);
  border: 1rpx solid #D8D0C4;
}
.gf-btn-normal { padding: 18rpx 0; width: 100%; }
.gf-btn-small { padding: 10rpx 24rpx; font-size: 26rpx; display: inline-flex; width: auto; }
.gf-btn-large { padding: 24rpx 0; font-size: 32rpx; }
.gf-btn-disabled { opacity: 0.45; }
.gf-btn-hover { opacity: 0.85; }
.gf-btn-loading {
  width: 26rpx;
  height: 26rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #fff;
  border-radius: 50%;
  animation: gf-spin 0.8s linear infinite;
}
.gf-btn-outline .gf-btn-loading, .gf-btn-ghost .gf-btn-loading { border-color: rgba(200,36,35,0.3); border-top-color: var(--color-cinnabar); }
@keyframes gf-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
