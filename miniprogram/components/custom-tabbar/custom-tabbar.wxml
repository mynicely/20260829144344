<view class="tabbar">
  <view class="tabbar-item {{current === item.index ? 'tabbar-item-active' : ''}}"
    wx:for="{{tabs}}" wx:key="index"
    data-index="{{item.index}}" bindtap="onTap">
    <view class="tabbar-icon {{current === item.index ? 'tabbar-icon-active' : ''}} font-art">{{item.icon}}</view>
    <view class="tabbar-label">{{item.label}}</view>
  </view>
</view>
