/* 全局国风设计规范（评审给定 CSS 变量，全局生效）
 * 正文一律系统无衬线字体；书法艺术字体（楷体类）仅允许用于大标题 / canvas 海报
 */
page {
  /* 全局色彩 */
  --bg-paper: #F8F5F0;          /* 宣纸米白页面底色 */
  --color-ink: #1A1A1A;         /* 墨黑正文 */
  --color-cinnabar: #C82423;    /* 朱砂红，主按钮、重点标签 */
  --color-stone: #4A6374;       /* 石青辅助色，次要文字、边框 */
  --color-gray-tip: #888888;    /* 辅助提示文字 */
  --card-bg: #ffffff;
  --radius-md: 12rpx;           /* 卡片圆角 */
  --border-thin: 1rpx solid #EAE3D8;  /* 仿宣纸细边框 */

  background-color: var(--bg-paper);
  color: var(--color-ink);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* 宣纸暗纹底：低透明度细线纹理，不遮挡文字阅读 */
.page-paper {
  position: relative;
  min-height: 100vh;
  background-color: var(--bg-paper);
  background-image:
    radial-gradient(circle at 20% 30%, rgba(74, 99, 116, 0.04) 0, transparent 60%),
    radial-gradient(circle at 80% 70%, rgba(200, 36, 35, 0.03) 0, transparent 55%),
    repeating-linear-gradient(0deg, transparent 0, transparent 23px, rgba(74, 99, 116, 0.015) 23px, rgba(74, 99, 116, 0.015) 24px);
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

/* ---------- 卡片 ---------- */
.card {
  background: var(--card-bg);
  border: var(--border-thin);
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin: 20rpx 24rpx;
  box-sizing: border-box;
}

/* ---------- 按钮（统一封装见 components/gf-button） ---------- */
.btn-primary {
  background: var(--color-cinnabar);
  color: #fff;
  border: none;
  border-radius: var(--radius-md);
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
}
.btn-primary.disabled { opacity: 0.45; }
.btn-outline {
  background: transparent;
  color: var(--color-cinnabar);
  border: 1rpx solid var(--color-cinnabar);
  border-radius: var(--radius-md);
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
}
.btn-ghost {
  background: transparent;
  color: var(--color-stone);
  border: 1rpx solid #D8D0C4;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  padding: 16rpx 0;
  text-align: center;
}

/* ---------- 书法艺术字体：仅用于大标题 / 海报 ---------- */
.font-art {
  font-family: 'STKaiti', 'KaiTi', 'Kaiti SC', '楷体', serif;
}

/* ---------- 文本工具 ---------- */
.tip { color: var(--color-gray-tip); font-size: 24rpx; }
.primary-text { color: var(--color-cinnabar); }
.stone-text { color: var(--color-stone); }
.price { color: var(--color-cinnabar); font-weight: 600; }
.price-through { color: var(--color-gray-tip); text-decoration: line-through; font-weight: 400; }
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ---------- 合规提示小字（评审要求多处埋入，不得删除） ---------- */
.compliance {
  color: var(--color-gray-tip);
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
  padding: 16rpx 32rpx 40rpx;
}

/* ---------- 空状态 ---------- */
.empty-wrap {
  padding: 120rpx 40rpx;
  text-align: center;
  color: var(--color-gray-tip);
}

/* ---------- 底部安全区占位 ---------- */
.safe-bottom { height: env(safe-area-inset-bottom); }

/* ---------- 通用行布局 ---------- */
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; }
