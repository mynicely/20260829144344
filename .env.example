# 复制为 .env（或直接以环境变量方式设置）后按需修改

# JWT 签名密钥：32 位以上随机字符串，生产环境必填
# 未设置时系统首次启动会自动生成随机密钥并持久化到数据库
JWT_SECRET=

# 后端监听端口（默认 3000）
PORT=3000

# 前端域名白名单（CORS，逗号分隔多个）
# 生产环境必填，如：CORS_ORIGINS=https://www.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 文件上传目录（默认 server/uploads，建议生产环境放到项目外）
# UPLOAD_DIR=/data/hanmo/uploads

# 运行环境：test 时不启动定时任务
NODE_ENV=production
